# Git ignore rules. Only README.md is versioned among markdown files: CLAUDE,
# AGENTS (and their .pt.md pairs) and docs/ stay on disk, never in the repo.
# Root .txt files are usually scratch or credential dumps. Keys, service
# accounts and client secrets are never versioned.

/dist
/node_modules
/.pnpm-store
/build

logs
*.log
npm-debug.log*
pnpm-debug.log*

.DS_Store
Thumbs.db

/coverage

/.idea
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

.env
.env.*
!.env.example

.temp
.tmp

*.tsbuildinfo

*.txt

*.md
!README.md
/docs/

.claude/
.cursor/
.github/copilot-instructions.md

*:Zone.Identifier

*.pem
*.key
*.p12
*.pfx
*-service-account.json
credentials*.json
client_secret*.json
secure/
