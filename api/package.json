{
  "name": "financial-api",
  "version": "0.0.1",
  "description": "Financial back-end: personal and business finance.",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@nestjs/common": "^11.2.10",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^11.0.3",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "helmet": "^8.3.0",
    "nestjs-paginate": "^13.5.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.18.1",
    "globals": "^17.14.0",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "scripts": {
    "build": "nest build && pnpm run build:migrations",
    "build:migrations": "tsc -p tsconfig.migrations.json",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "pnpm run eslint:check && pnpm run prettier:check",
    "eslint:check": "eslint \"{src,test,database}/**/*.ts\"",
    "eslint:fix": "pnpm run eslint:check --fix",
    "prettier:check": "prettier --check \"{src,test,database}/**/*.ts\" \"*.{js,mjs,json}\"",
    "format": "prettier --write \"{src,test,database}/**/*.ts\" \"*.{js,mjs,json}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config ./test/jest.config.ts --runInBand",
    "test:cov": "jest --config ./test/jest.config.ts --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "precommit": "lint-staged && pnpm run lint && pnpm run typecheck && pnpm run test",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d src/config/datasource.ts",
    "migration:generate": "pnpm run typeorm migration:generate",
    "migration:run": "pnpm run typeorm migration:run",
    "migration:revert": "pnpm run typeorm migration:revert",
    "migration:show": "pnpm run typeorm migration:show",
    "migration:run:prod": "node ./node_modules/typeorm/cli.js -d dist/config/datasource.js migration:run",
    "migration:show:prod": "node ./node_modules/typeorm/cli.js -d dist/config/datasource.js migration:show",
    "seed:demo": "ts-node -r tsconfig-paths/register database/seeds/demo.seed.ts",
    "db:reset": "pnpm run typeorm schema:drop && pnpm run migration:run"
  },
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-fc5q-39xc-vjpf"
      ]
    }
  }
}
