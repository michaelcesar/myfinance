#!/usr/bin/env bash
#
# Roda o ESLint nos arquivos .ts do índice antes de cada commit.
#
# Lint só do que está staged, com as dependências locais: rápido o bastante
# para não ser pulado. O CI completo (lint, typecheck, testes, e2e, build)
# fica no pre-push, via scripts/ci-local.sh.
#
# Ativado uma vez por clone com: git config core.hooksPath .githooks
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"

mapfile -t FILES < <(git -C "$REPO" diff --cached --name-only --diff-filter=ACMR -- 'src/*.ts' 'test/*.ts' 'database/*.ts')
if [[ ${#FILES[@]} -eq 0 ]]; then
  exit 0
fi

cd "$REPO"
node node_modules/eslint/bin/eslint.js "${FILES[@]}"
node node_modules/prettier/bin/prettier.cjs --check "${FILES[@]}"
