#!/usr/bin/env bash
#
# Runs ESLint and Prettier on the staged .ts files before each commit.
# Only staged files are checked, so it stays fast; the full CI (lint,
# typecheck, tests, e2e, build) runs in the pre-push hook via scripts/ci-local.sh.
#
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"

mapfile -t FILES < <(git -C "$REPO" diff --cached --name-only --diff-filter=ACMR -- 'src/*.ts' 'test/*.ts' 'database/*.ts')
if [[ ${#FILES[@]} -eq 0 ]]; then
  exit 0
fi

cd "$REPO"
node node_modules/eslint/bin/eslint.js "${FILES[@]}"
node node_modules/prettier/bin/prettier.cjs --check "${FILES[@]}"
