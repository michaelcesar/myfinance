#!/usr/bin/env bash
#
# Bloqueia o push se algum commit enviado não passar no CI local.
#
# O Git entrega uma linha por ref: "<ref local> <sha local> <ref remota>
# <sha remoto>". Cada sha local é checado por scripts/ci-local.sh, que roda
# os mesmos jobs de .github/workflows/ci.yml num clone limpo.
#
# Ativado uma vez por clone com: git config core.hooksPath .githooks
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"
REPO="$(git rev-parse --show-toplevel)"

while read -r local_ref local_sha remote_ref _remote_sha; do
  if [[ "$local_sha" == "$ZERO" ]]; then
    continue
  fi
  echo "▶ pre-push: conferindo ${local_ref} antes de chegar em ${remote_ref}"
  "$REPO/scripts/ci-local.sh" "$local_sha"
done
