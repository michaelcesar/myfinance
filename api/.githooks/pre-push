#!/usr/bin/env bash
#
# Blocks the push if any pushed commit fails the local CI.
# Git feeds one line per ref ("<local ref> <local sha> <remote ref> <remote sha>");
# each local sha is checked by scripts/ci-local.sh, which runs the jobs of
# .github/workflows/ci.yml on a clean clone.
#
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"
REPO="$(git rev-parse --show-toplevel)"

while read -r local_ref local_sha remote_ref _remote_sha; do
  if [[ "$local_sha" == "$ZERO" ]]; then
    continue
  fi
  echo "▶ pre-push: checking ${local_ref} before it reaches ${remote_ref}"
  "$REPO/scripts/ci-local.sh" "$local_sha"
done
