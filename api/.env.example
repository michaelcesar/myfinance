# Local development variables for the API (copy to .env and adjust).
#
#   APP_SECRET                 access JWT secret, at least 32 characters
#                              (openssl rand -base64 48 | tr -d '\n').
#   POSTGRES_URI               development database (financial_postgres, port 5435), e.g.
#                              postgresql://postgres:PASSWORD@localhost:5435/financial with
#                              the password from tools/docker/docker-compose.yml.
#   TYPEORM_SYNC               local development only; always false in production.
#   ACCESS_TOKEN_TTL_SECONDS   access token lifetime.
#   REFRESH_TOKEN_TTL_DAYS     session (refresh token) lifetime.
#   ALLOW_SIGNUP               open sign-up beyond the first user (the first can always sign up).
#   SEED_DEMO_*                demo seed account (pnpm run seed:demo), local only; the seed
#                              refuses to run without SEED_DEMO_PASSWORD.

PORT=3001
NODE_ENV=development
APP_NAME="Finance Manager API"
APP_SECRET=
FRONTEND_DOMAIN=http://localhost:3000

POSTGRES_URI=
TYPEORM_LOG=false
TYPEORM_SYNC=false

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
ALLOW_SIGNUP=false

SEED_DEMO_EMAIL=user@user.com
SEED_DEMO_PASSWORD=
