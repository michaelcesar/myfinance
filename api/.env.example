# Variáveis da API para desenvolvimento local (copie para .env e ajuste).
#
#   APP_SECRET                 segredo do JWT de acesso, mínimo de 32 caracteres.
#   POSTGRES_URI               banco de desenvolvimento (financial_postgres, porta 5435).
#   TYPEORM_SYNC               só em desenvolvimento local; em produção sempre vale false.
#   ACCESS_TOKEN_TTL_SECONDS   duração do token de acesso.
#   REFRESH_TOKEN_TTL_DAYS     duração da sessão (refresh token).
#   ALLOW_SIGNUP               cadastro aberto além do primeiro usuário (o primeiro sempre pode).
#   SEED_DEMO_*                conta do seed de demonstração (pnpm run seed:demo), só local.

PORT=3001
NODE_ENV=development
APP_NAME="Finance Manager API"
APP_SECRET=change-me-to-a-long-random-string-with-32-chars
FRONTEND_DOMAIN=http://localhost:3000

POSTGRES_URI=postgresql://postgres:postgres@localhost:5435/financial
TYPEORM_LOG=false
TYPEORM_SYNC=false

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
ALLOW_SIGNUP=false

SEED_DEMO_EMAIL=user@user.com
SEED_DEMO_PASSWORD=123
