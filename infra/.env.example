# Finance Manager: configuration of the local stack (infra/docker-compose.yml).
#
# Secrets stay empty here. Run `scripts/setup.sh` (or `make setup`),
# which copies it to `.env` with random APP_SECRET and POSTGRES_PASSWORD values.
# `.env` is never committed.
#
# Variables:
#   APP_PORT                   front-end port on loopback (http://localhost:APP_PORT).
#   APP_SECRET                 signs the access tokens (JWT), at least 32 characters.
#                              Generate with: openssl rand -base64 48 | tr -d '\n'.
#                              Changing it ends every open session.
#   POSTGRES_*                 database (container `postgres`, not published). The
#                              password goes into a connection URL: use only letters
#                              and digits (setup.sh generates hex). It only takes
#                              effect when the volume is first created.
#   ALLOW_SIGNUP               open sign-up beyond the first user; with false nobody
#                              else can create an account.
#   ACCESS_TOKEN_TTL_SECONDS   access token lifetime.
#   REFRESH_TOKEN_TTL_DAYS     session lifetime.
#   BACKUP_KEEP                how many backups to keep in infra/backups/ (make backup).
#   APP_VERSION                version stamped into the images (optional; empty = none).

APP_PORT=8080

APP_SECRET=

POSTGRES_USER=finance
POSTGRES_PASSWORD=
POSTGRES_DB=finance_manager

ALLOW_SIGNUP=false

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

BACKUP_KEEP=14

APP_VERSION=
