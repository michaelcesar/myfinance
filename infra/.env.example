# Finance Manager — configuração do stack local (infra/docker-compose.yml).
#
# Não edite este arquivo com valores reais: rode `scripts/setup.sh` (ou
# `make setup`), que copia este modelo para `.env` gerando APP_SECRET e
# POSTGRES_PASSWORD aleatórios. O `.env` nunca é versionado.
#
# Variáveis:
#   APP_PORT                   porta do front-end no loopback (http://localhost:APP_PORT).
#   APP_SECRET                 assina os tokens de acesso (JWT), mínimo de 32 caracteres.
#                              Gere com: openssl rand -base64 48 | tr -d '\n'. Trocar o
#                              valor encerra todas as sessões abertas.
#   POSTGRES_*                 banco (container `postgres`, não publicado no host). A senha
#                              entra numa URL de conexão: use só letras e números (o
#                              setup.sh gera hex). Ela só vale na criação do volume.
#   ALLOW_SIGNUP               cadastro aberto além do primeiro usuário; com false, ninguém
#                              mais cria conta depois dele.
#   ACCESS_TOKEN_TTL_SECONDS   duração do token de acesso.
#   REFRESH_TOKEN_TTL_DAYS     duração da sessão.
#   BACKUP_KEEP                quantos backups manter em infra/backups/ (make backup).
#   APP_VERSION                versão gravada nas imagens (opcional; vazio = sem versão).

APP_PORT=8080

APP_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres

POSTGRES_USER=finance
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=finance_manager

ALLOW_SIGNUP=false

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

BACKUP_KEEP=14

APP_VERSION=
