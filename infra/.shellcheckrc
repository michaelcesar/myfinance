# ShellCheck settings for scripts/*.sh.
# `# shellcheck source=lib.sh` resolves relative to the script's own folder.
# SC2016 (single quotes without expansion) is disabled on purpose: commands
# passed to `compose exec postgres sh -c '...'` use $POSTGRES_USER and
# $POSTGRES_DB from the CONTAINER environment and must not expand on the host.

source-path=SCRIPTDIR
external-sources=true

disable=SC2016
