# locais (o dev server em execução escreve em .next — copiá-lo sujaria o build),
# docs, hooks e configuração de CI.
node_modules
.next
out
build
coverage
.git
.githooks
.github
.vscode
.idea
.claude
docs
scripts
*.md
*.log
*.tsbuildinfo
next-env.d.ts
