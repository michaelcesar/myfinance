# Build context of the Docker image (Dockerfile at the repo root).
# Excludes everything next build generates or does not use (the running dev
# server writes to .next, so copying it would dirty the build), docs, hooks,
# CI config and secrets (.env files, keys, certificates).
node_modules
.next
out
build
coverage
.git
.githooks
.github
.vscode
.idea
.claude
docs
scripts
*.md
*.log
*.tsbuildinfo
next-env.d.ts
Dockerfile
.dockerignore
.env
.env.*
!.env.example
secure
*.pem
*.key
*.p12
*-service-account.json
