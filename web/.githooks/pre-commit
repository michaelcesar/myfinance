#!/usr/bin/env bash
#
# Roda ESLint e Prettier nos arquivos do índice antes de cada commit.
# Ativado uma vez por clone com: git config core.hooksPath .githooks
set -euo pipefail

REPO="$(git rev-parse --show-toplevel)"
mapfile -t FILES < <(git -C "$REPO" diff --cached --name-only --diff-filter=ACMR -- 'src/*.ts' 'src/*.tsx' 'src/*.css' '*.ts' '*.mts' '*.mjs')
if [[ ${#FILES[@]} -eq 0 ]]; then
  exit 0
fi

cd "$REPO"
LINTABLE=()
for file in "${FILES[@]}"; do
  [[ "$file" == *.css ]] || LINTABLE+=("$file")
done
if [[ ${#LINTABLE[@]} -gt 0 ]]; then
  node node_modules/eslint/bin/eslint.js "${LINTABLE[@]}"
fi
node node_modules/prettier/bin/prettier.cjs --check "${FILES[@]}"
