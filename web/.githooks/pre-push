#!/usr/bin/env bash
#
# Pre-push hook: blocks the push if any pushed commit fails the local CI.
#
# Git passes one line per ref: "<local ref> <local sha> <remote ref> <remote
# sha>". Each local sha is checked by scripts/ci-local.sh, which runs the jobs
# of .github/workflows/ci.yml (plus the Docker image build) on a clean clone
# inside a node:22 container, never in the working tree, so the dev server's
# .next stays intact.
#
# Enabled once per clone with: git config core.hooksPath .githooks
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"
REPO="$(git rev-parse --show-toplevel)"

while read -r local_ref local_sha remote_ref _remote_sha; do
  if [[ "$local_sha" == "$ZERO" ]]; then
    continue
  fi
  echo "▶ pre-push: checking ${local_ref} before it reaches ${remote_ref}"
  "$REPO/scripts/ci-local.sh" "$local_sha"
done
