# Git ignore rules. Only README.md is versioned among the Markdown files:
# CLAUDE.md, AGENTS.md (including the block next dev rewrites), the .pt.md
# pairs and docs/ stay local. Root .txt files are usually drafts or credential
# dumps. Env files and credentials are never versioned.
/node_modules
/.pnpm-store
/.next/
/out/
/build
/coverage
.DS_Store
*.pem
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
pnpm-debug.log*
.env
.env.*
!.env.example
*.txt
*.md
!README.md
/docs/
.claude/
.cursor/
.vscode/*
!.vscode/settings.json
.github/copilot-instructions.md
*:Zone.Identifier
*.key
*.p12
*-service-account.json
secure/
